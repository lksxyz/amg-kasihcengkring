# ─── Network switch ──────────────────────────────────────────────────────────
# testnet (default) → Arc Testnet, chain 5042002
# mainnet           → Arc Mainnet, chain 5042
#
# This is the only value to change when the site moves between networks. Every
# per-network value below is read from the matching group.
VITE_ARC_NETWORK=testnet

# ─── Testnet group (used when VITE_ARC_NETWORK=testnet) ──────────────────────
VITE_TESTNET_KASIH_ADDRESS=0xbff209b432510373cc5c87d11d1889c42886cbf1
VITE_TESTNET_KASIH_DEPLOY_BLOCK=68883124
# Optional: RPC and WebSocket RPC. Unset = the network's public endpoints.
# VITE_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# VITE_TESTNET_WSS_URL=wss://rpc.testnet.arc.io
# Optional: wallet-prompt name, explorer link, and USDC override.
# VITE_TESTNET_CHAIN_NAME=Arc Testnet
# VITE_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.io
# VITE_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ─── Mainnet group (used when VITE_ARC_NETWORK=mainnet) ─────────────────────
VITE_MAINNET_KASIH_ADDRESS=0x4030419B833B8265D8298360B507B2E2B5A0817A
VITE_MAINNET_KASIH_DEPLOY_BLOCK=27650479
# VITE_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# VITE_MAINNET_WSS_URL=wss://rpc.mainnet.arc.io
# VITE_MAINNET_CHAIN_NAME=Arc
# VITE_MAINNET_EXPLORER_URL=https://explorer.arc.io
# VITE_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ─── Supabase mirror (per network) ──────────────────────────────────────────
# Testnet and mainnet use separate projects so test data never mixes with real data.
# The UI degrades gracefully when these are absent: everything reads from chain.
# VITE_TESTNET_SUPABASE_URL=https://<testnet-project>.supabase.co
# VITE_TESTNET_SUPABASE_ANON_KEY=<testnet-anon-key>
# VITE_MAINNET_SUPABASE_URL=https://<mainnet-project>.supabase.co
# VITE_MAINNET_SUPABASE_ANON_KEY=<mainnet-anon-key>
# Optional: per-network creator-stats aggregation endpoint. Defaults to
# <project>/functions/v1/creator-stats; set an empty value to disable the call
# (dashboard stats then come from chain logs only).
# VITE_TESTNET_CREATOR_STATS_URL=
# VITE_MAINNET_CREATOR_STATS_URL=
# Optional: creator shown in the landing-page example card.
# VITE_EXAMPLE_CREATOR=<username>

# ─── Legacy single-network overrides ────────────────────────────────────────
# Still honoured as a fallback, mainly for `bun run dev:local`. Prefer the
# per-network variables above so switching stays a one-line change.
# VITE_ARC_RPC_URL=http://127.0.0.1:8545
# VITE_ARC_WSS_URL=wss://rpc.testnet.arc.io
# VITE_ARC_CHAIN_NAME=Arc Local
# VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# VITE_KASIH_ADDRESS=0x...
# VITE_KASIH_DEPLOY_BLOCK=0
# VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
