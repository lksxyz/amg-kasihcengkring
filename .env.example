# KasihCengkring contract address.
# No testnet deployment ships by default: leave this unset and the UI reports the app
# as not deployed. Set it to the address printed by your deploy (or by `bun run dev:local`,
# which writes it to .env.localdev instead).
# VITE_KASIH_ADDRESS=0x...

# Optional: first block containing the contract. Log scans (profiles, history, overlay)
# start here instead of a 50 000-block rolling window, which turns a full scan into one
# `eth_getLogs` call. Set it to the deploy block from your deploy receipt.
# VITE_KASIH_DEPLOY_BLOCK=0

# Optional: off-chain profile / donation mirror (Supabase REST).
# The UI degrades gracefully when these are absent: everything reads from chain.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
# Optional: override the creator-stats aggregation endpoint. It defaults to
# <VITE_SUPABASE_URL>/functions/v1/creator-stats; set an empty value to disable the call
# (dashboard stats then come from chain logs only).
# VITE_CREATOR_STATS_URL=https://<project>.supabase.co/functions/v1/creator-stats

# RPC this build talks to. Unset = Arc Testnet's public RPC from viem.
# Point it at a local node, Arc Testnet, or a mainnet node. The header network
# button reads the chain ID from this RPC and adds/switches the wallet to it.
# VITE_ARC_RPC_URL=http://127.0.0.1:8545
# Optional WebSocket RPC used by the OBS overlay (/overlay). Unset = derive ws(s) from
# VITE_ARC_RPC_URL, or use Arc Testnet's WSS endpoint from viem when that is unset too.
# Set this when the provider exposes WebSocket on a different host or path.
# VITE_ARC_WSS_URL=wss://rpc.testnet.arc.io
# Display name and explorer for the added network.
# VITE_ARC_CHAIN_NAME=Arc Local
# VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# USDC address override (defaults to the Arc Testnet predeploy from onchain-facts).
# VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
