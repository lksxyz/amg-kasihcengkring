# KasihCengkring contract address (Arc Testnet).
# Defaults to the current testnet deployment when unset; override for a new deploy.
VITE_KASIH_ADDRESS=0xe9ed1145c0ec41220a1dc6b76bee0b860d078678

# Optional: off-chain profile / donation mirror (Supabase REST).
# The UI degrades gracefully when these are absent: everything reads from chain.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
